{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aruntas-portfolio",
  "compatibility_date": "2026-10-06",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public"
  },
  "routes": [
    { "pattern": "aruntas.com", "custom_domain": true },
    { "pattern": "www.aruntas.com", "custom_domain": true }
  ]
}

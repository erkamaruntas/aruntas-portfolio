{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aruntas-portfolio",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-06",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // www yönlendirmesi statik dosyalardan önce çalışsın diye
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "aruntas.com", "custom_domain": true },
    { "pattern": "www.aruntas.com", "custom_domain": true }
  ]
}
